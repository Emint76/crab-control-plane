{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crab-control-plane.local/schemas/kb_taxonomy_config.v1.schema.json",
  "title": "Instance-local KB taxonomy config contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_kind",
    "config_version",
    "local_only",
    "allowed_knowledge_types",
    "profile_knowledge_type_map"
  ],
  "properties": {
    "config_kind": {
      "type": "string",
      "const": "kb_taxonomy_config"
    },
    "config_version": {
      "type": "integer",
      "const": 1
    },
    "local_only": {
      "type": "boolean",
      "const": true
    },
    "allowed_knowledge_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path_segment"
      }
    },
    "profile_knowledge_type_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/path_segment"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/profile_id"
      }
    }
  },
  "$defs": {
    "path_segment": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      },
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
