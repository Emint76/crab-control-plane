{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/crab-control-plane/openclaw-live-retention/secret_material_source_declaration.schema.json",
  "title": "Secret Material Source Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "declaration_kind",
    "declaration_label",
    "execution_label",
    "local_only",
    "outside_git",
    "sources"
  ],
  "properties": {
    "declaration_kind": {
      "const": "secret-material-source-declaration"
    },
    "declaration_label": {
      "type": "string",
      "minLength": 1
    },
    "execution_label": {
      "type": "string",
      "minLength": 1
    },
    "local_only": {
      "const": true
    },
    "outside_git": {
      "const": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_label",
          "source_class",
          "source_path",
          "contains_raw_secrets"
        ],
        "properties": {
          "source_label": {
            "type": "string",
            "minLength": 1
          },
          "source_class": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:/|[A-Za-z]:[\\\\/]).+"
          },
          "contains_raw_secrets": {
            "const": true
          }
        }
      }
    }
  }
}
