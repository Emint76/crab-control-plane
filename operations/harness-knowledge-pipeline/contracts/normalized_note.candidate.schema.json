{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "normalized_note_candidate",
  "type": "object",
  "required": ["note_id", "artifact_type", "status", "source_capture_ref", "title", "summary", "claims", "gaps", "confidence"],
  "properties": {
    "note_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "artifact_type": {"type": "string", "const": "normalized-note"},
    "status": {"type": "string", "enum": ["working", "candidate", "needs-review"]},
    "source_capture_ref": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 10},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "source_refs", "confidence"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "text": {"type": "string", "minLength": 10},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
        },
        "additionalProperties": false
      }
    },
    "gaps": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
  },
  "additionalProperties": false
}
