{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operations/harness-phase4/contracts/phase4_invocation_claim.schema.json",
  "title": "Phase 4 invocation claim for Phase 3 KB admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "claim_id",
    "wrapper_run_id",
    "wrapper_run_ref",
    "phase3_run_id",
    "phase3_run_ref",
    "target_kind",
    "execution_target_ref",
    "execution_target_sha256",
    "phase2_run_ref",
    "created_at",
    "invocation_intent",
    "invariants"
  ],
  "properties": {
    "schema_name": {
      "type": "string",
      "const": "phase4_invocation_claim"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^phase4-invocation:[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:[0-9a-f]{64}$"
    },
    "wrapper_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "wrapper_run_ref": {
      "type": "string",
      "pattern": "^operations/harness-phase4/runs/[A-Za-z0-9._-]+$"
    },
    "phase3_run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "phase3_run_ref": {
      "type": "string",
      "pattern": "^operations/harness-phase3/runs/[A-Za-z0-9._-]+$"
    },
    "target_kind": {
      "type": "string",
      "const": "kb_admission"
    },
    "execution_target_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+\\.json$"
    },
    "execution_target_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase2_run_ref": {
      "type": "string",
      "pattern": "^operations/harness-phase2/runs/[A-Za-z0-9._-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "invocation_intent": {
      "type": "string",
      "const": "phase4_wrapper_invokes_phase3_kb_admission"
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase3_canonical_execution_owner",
        "phase4_thin_wrapper_only",
        "phase4_claim_ref",
        "phase4_owns_canonical_outputs",
        "proof_scope"
      ],
      "properties": {
        "phase3_canonical_execution_owner": {
          "type": "boolean",
          "const": true
        },
        "phase4_thin_wrapper_only": {
          "type": "boolean",
          "const": true
        },
        "phase4_claim_ref": {
          "type": "string",
          "pattern": "^operations/harness-phase4/runs/[A-Za-z0-9._-]+/phase4_invocation_claim\\.json$"
        },
        "phase4_owns_canonical_outputs": {
          "type": "boolean",
          "const": false
        },
        "proof_scope": {
          "type": "string",
          "const": "repo_contained_exact_run_linkage_not_cryptographic_authentication"
        }
      }
    }
  }
}
